<UserControl x:Class="DirPorter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markup="clr-namespace:DirPorter.App.Markup">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitle}" Text="{markup:Loc set.title}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ============ 通用 ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Loc set.general}" />

                        <DockPanel Margin="0,6,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}"
                                       Text="{markup:Loc set.language}" MinWidth="170" />
                            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}"
                                      DisplayMemberPath="Display" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}"
                                       Text="{markup:Loc set.theme}" MinWidth="170" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                                      DisplayMemberPath="Display" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}"
                                       Text="{markup:Loc set.threads}" MinWidth="170" />
                            <TextBox Text="{Binding Threads, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>

                        <!-- 默认建链类型：迁移页 / 扫描页「一键迁移并建链」共用；默认目录联接 -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}"
                                       Text="{markup:Loc set.defaultLinkKind}" MinWidth="170" />
                            <ComboBox ItemsSource="{Binding LinkKindOptions}" SelectedItem="{Binding SelectedLinkKind}"
                                      DisplayMemberPath="Display" ToolTip="{Binding SelectedLinkKind.Hint}">
                                <ComboBox.ItemContainerStyle>
                                    <!-- 文件级两种置灰（目标必须是文件，不能用于目录迁移） -->
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="IsEnabled" Value="{Binding CanUseForMigration}" />
                                        <Setter Property="ToolTip" Value="{Binding DisabledHint}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{markup:Loc set.defaultLinkKindHint}"
                                   Margin="0,0,0,10" />

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}"
                                       Text="{markup:Loc set.backupRetention}" MinWidth="170" />
                            <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="{markup:Loc set.save}"
                                    Command="{Binding SaveCommand}" Margin="0,0,6,0" />
                            <Button Content="{markup:Loc set.openDataRoot}" Command="{Binding OpenDataRootCommand}" Margin="0,0,6,0" />
                            <Button Content="{markup:Loc set.openCrashFolder}" Command="{Binding OpenCrashFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 权限能力 ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Loc common.privileges}" />

                        <ItemsControl ItemsSource="{Binding PrivilegeLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Right" MinWidth="70" TextAlignment="Right"
                                                   Text="{Binding State}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{markup:Loc priv.restartElevated}"
                                    ToolTip="{markup:Loc priv.restartElevatedHint}"
                                    Command="{Binding RestartElevatedCommand}"
                                    IsEnabled="{Binding CanRestartElevated}"
                                    Margin="0,0,10,0" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" MaxWidth="560"
                                       Text="{markup:Loc priv.restartElevatedHint}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,14,0,4"
                                   Text="{markup:Loc priv.whyLimitedTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{markup:Loc priv.whyLimitedBody}" />

                        <TextBlock Style="{StaticResource Hint}" Text="{Binding ElevationText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- ============ 风险提示 ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Loc set.riskyTitle}" />
                        <TextBlock Style="{StaticResource WarningText}" Text="{markup:Loc set.riskyBody}" />
                    </StackPanel>
                </Border>

                <!-- ============ .migbak 停车区（迁移备份） ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Loc set.parkingTitle}" />
                            <Button DockPanel.Dock="Right" Content="{markup:Loc set.parkingPurge}"
                                    Command="{Binding PurgeExpiredBackupsCommand}"
                                    IsEnabled="{Binding CanPurgeBackups}"
                                    ToolTip="{markup:Loc set.parkingPurgeHint}"
                                    Margin="6,0,0,0" HorizontalAlignment="Right" />
                            <Button DockPanel.Dock="Right" Content="{markup:Loc set.parkingRefresh}"
                                    Command="{Binding RefreshParkingsCommand}" HorizontalAlignment="Right" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource Hint}" Text="{markup:Loc set.parkingHint}"
                                   TextWrapping="Wrap" MaxWidth="560" Margin="0,2,0,6" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding ParkingSummary}" Margin="0,0,0,6" />

                        <ItemsControl ItemsSource="{Binding Parkings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource TinyButton}" Content="{markup:Loc set.parkingOpen}"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.OpenParkingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource TinyButton}" Content="{markup:Loc set.parkingDelete}"
                                                        Command="{Binding DataContext.DeleteParkingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}" />
                                                <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ 一键更新 ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Loc set.updateTitle}" />

                        <TextBlock Style="{StaticResource Hint}" Text="{Binding UpdateSourceText}"
                                   TextWrapping="Wrap" MaxWidth="560" Margin="0,2,0,6" />

                        <Button Style="{StaticResource PrimaryButton}" Content="{markup:Loc set.updateNow}"
                                Command="{Binding UpdateNowCommand}" IsEnabled="{Binding CanUpdate}"
                                HorizontalAlignment="Left" MinWidth="150"
                                ToolTip="{markup:Loc set.updateNowHint}" />

                        <TextBlock Style="{StaticResource Hint}" Text="{Binding UpdateStatus}"
                                   TextWrapping="Wrap" MaxWidth="560" Margin="0,8,0,0" />

                        <Expander Header="{markup:Loc set.updateAdvanced}" Margin="0,10,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource Hint}" Text="{markup:Loc set.updateFeedHint}"
                                           TextWrapping="Wrap" MaxWidth="540" Margin="0,0,0,4" />
                                <TextBox MinWidth="320" HorizontalAlignment="Left"
                                         Text="{Binding UpdateFeedUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- ============ 关于 ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{markup:Loc set.about}" />

                        <DockPanel Margin="0,2">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}"
                                       Text="{markup:Loc set.version}" MinWidth="170" />
                            <TextBlock Text="{Binding Version}" />
                        </DockPanel>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Label}"
                                       Text="{markup:Loc priv.dataRoot}" MinWidth="170" />
                            <Button Grid.Column="1" Style="{StaticResource PathLinkButton}"
                                    Content="{Binding DataRoot}"
                                    ToolTip="{markup:Loc common.clickToCopy}"
                                    Command="{Binding CopyDataRootCommand}"
                                    HorizontalAlignment="Left" />
                            <Button Grid.Column="2" Style="{StaticResource TinyButton}"
                                    Content="{markup:Loc common.open}"
                                    ToolTip="{markup:Loc common.openFolder}"
                                    Command="{Binding OpenDataRootCommand}" />
                        </Grid>

                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Content="{markup:Loc set.sweepBackups}"
                                Command="{Binding SweepBackupsCommand}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
