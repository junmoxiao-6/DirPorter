<?xml version="1.0" encoding="utf-8"?>
<!--
  DirPorter 单 exe 应用清单（默认变体：asInvoker）

  注意：XML 注释里不能出现两个连续的连字符（XML 规范硬限制）。
  历史教训：注释里写了命令行参数的双连字符形式会导致清单非法，
  编译照过、但 exe 一启动就报「应用程序的并行配置不正确」（SxS 拒绝生成激活上下文）。
  R6 已加单元测试校验清单必须是合法 XML。

  为什么默认不是 requireAdministrator（与需求原文的显式偏离）：
  需求要求「默认 requireAdministrator，同时提供以普通权限运行的降级路径」。
  单 exe 产品里这两件事无法同时成立：写了 requireAdministrator 之后，
  连只读的 inspect / scan、干跑预览都会弹 UAC，且无法在同一 exe 内切回普通权限。
  因此本清单取 asInvoker：默认只读、扫描、干跑全程无 UAC；
  需要提权的操作由程序按需提示；需要「启动即提权」的部署用 app.admin.manifest
  （由 publish.ps1 的 RequireAdmin 开关一键切换）。
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="dirporter" type="win32" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
