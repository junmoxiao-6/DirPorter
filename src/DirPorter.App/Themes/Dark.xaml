<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题：浅色文字 + 深色面板（文字必须保持高对比可读） -->

    <SolidColorBrush x:Key="WindowBg" Color="#1B1D21" />
    <SolidColorBrush x:Key="PanelBg" Color="#23262B" />
    <SolidColorBrush x:Key="CardBg" Color="#262A30" />
    <SolidColorBrush x:Key="CardBorder" Color="#383D45" />
    <SolidColorBrush x:Key="SelectionBg" Color="#2C3A50" />
    <SolidColorBrush x:Key="DangerSolidBg" Color="#E5534B" />
    <SolidColorBrush x:Key="DangerSolidFg" Color="#1B1D21" />

    <SolidColorBrush x:Key="ListRowAlt" Color="#2A2E35" />
    <SolidColorBrush x:Key="WarnBannerBg" Color="#3A3320" />

    <SolidColorBrush x:Key="TextPrimary" Color="#EDF0F3" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B9C0C8" />
    <SolidColorBrush x:Key="TextMuted" Color="#8A939D" />

    <SolidColorBrush x:Key="AccentBg" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentFg" Color="#0B1220" />

    <SolidColorBrush x:Key="ControlBg" Color="#2C3037" />
    <SolidColorBrush x:Key="ControlBorder" Color="#414751" />
    <SolidColorBrush x:Key="ControlBgHover" Color="#333943" />

    <SolidColorBrush x:Key="DangerBg" Color="#4A2326" />
    <SolidColorBrush x:Key="DangerFg" Color="#FFB4AB" />
    <SolidColorBrush x:Key="WarnFg" Color="#F5C86B" />
    <SolidColorBrush x:Key="OkFg" Color="#7BD8A4" />

    <SolidColorBrush x:Key="ProgressTrack" Color="#33383F" />
    <SolidColorBrush x:Key="ProgressFill" Color="#3B82F6" />

    <SolidColorBrush x:Key="NavBg" Color="#202329" />
    <SolidColorBrush x:Key="NavFg" Color="#C6CCD4" />
    <SolidColorBrush x:Key="NavActiveBg" Color="#2E3B52" />
    <SolidColorBrush x:Key="NavActiveFg" Color="#BFD4FF" />

</ResourceDictionary>
