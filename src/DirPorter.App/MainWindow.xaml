<Window x:Class="DirPorter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markup="clr-namespace:DirPorter.App.Markup"
        Title="{Binding Title}"
        Icon="pack://application:,,,/dirporter;component/Resources/app.ico"
        Height="820" Width="1280" MinHeight="480" MinWidth="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="{StaticResource FontSizeBody}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧导航 ================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource NavBg}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,12">
                    <TextBlock Text="DirPorter"
                               FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource NavActiveFg}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{markup:Loc app.title}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               ToolTip="{markup:Loc app.title}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="6,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource NavFg}" />
                            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                CornerRadius="6"
                                                Margin="4,2"
                                                Padding="12,10"
                                                Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBg}" />
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBg}" />
                                                <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= 内容区 + 权限横幅 + 底部即时提示 ================= -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource NavBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="16,6">
                <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusMessage}" />
            </Border>

            <!--
                权限横幅：未提权时常驻（启动时已自动请求过 UAC；用户取消或启动失败也会看到它）。
                已提权时 Visibility=Collapsed，不占高度、不骚扰。
            -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource WarnBannerBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8"
                    Visibility="{Binding ElevationBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="{markup:Loc priv.restartElevated}"
                            ToolTip="{markup:Loc priv.restartElevatedHint}"
                            Command="{Binding RestartElevatedCommand}"
                            Margin="12,0,0,0" />
                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Text="{Binding ElevationBannerText}" />
                </DockPanel>
            </Border>

            <!--
                R12：内容区包一层 ScrollViewer —— 窗口可以继续缩小（最小 820x540），
                再小只会出现滚动条；内层 Grid 的最小尺寸保证"Auto 行吃 * 行"的塌陷不再发生。
            -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Focusable="False">
                <Grid x:Name="PageHost" MinWidth="420" MinHeight="620">
                    <ContentControl Content="{Binding CurrentPage}" Margin="16" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
