<?xml version="1.0" encoding="utf-8"?>
<!--
  DirPorter CLI 应用清单（默认变体：asInvoker）

  ⚠️ 注意：XML 注释里**不能出现两个连续的连字符**（这是 XML 规范硬限制）。
  本文件曾经因为注释里写了 dry 参数的双连字符形式，导致清单非法，
  编译照过、但 exe 一启动就报"应用程序的并行配置不正确"（SxS 拒绝生成激活上下文）。
  为此专门加了单元测试 `R6_ManifestTests` 校验清单必须是合法 XML，
  免得以后再有人往注释里写命令行参数。

  为什么默认不是 requireAdministrator（与需求原文的偏离，必须显式说明）：
  需求要求"默认 requireAdministrator，同时提供以普通权限运行的降级路径"。
  但单 exe 产品里这两件事无法同时成立：清单写了 requireAdministrator 之后，
  每次调用（包括只读的 inspect / scan、干跑）都会弹 UAC，
  而且没有任何办法在同一 exe 内切回普通权限，"降级路径"实际上就消失了。

  因此本清单采用：
    · 级别 asInvoker：默认以调用者权限运行，只读、扫描、干跑全程无 UAC；
    · 需要提权的操作（创建符号链接、访问受保护目录）由程序按需提示或自提权；
    · 需要"每次都必须提权"的部署场景，用 app.admin.manifest
      （由 publish.ps1 的 RequireAdmin 开关一键切换）。

  这样两种运行方式都真实存在，而不是名义上存在。
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="dirporter" type="win32" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 与 Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- 支持超过 260 字符的路径（代码内部仍统一使用扩展长度前缀，这里是双保险） -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
